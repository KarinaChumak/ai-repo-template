#!/usr/bin/env bash
# Writes the Claude Code setup from this template into a repo. Must run on macOS's bash 3.2.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)

usage() {
  cat <<EOF
Usage: ./init [--stack <name>] [--mode solo|team] [--into <dir>] [--notes external|in-repo] [--decisions-file <path>] [--name <project>] [--ci-review] [--no-pr] [--protect-main] [--force]

  --stack           Which stack to set up. Asked interactively if omitted.
  --mode            solo (default) or team. Team adds CODEOWNERS.
  --into            Add the setup to an existing repo instead of turning this clone into the project.
  --notes           Where plans, the product brief and decisions live. external (default): ~/claude-notes/<repo>/,
                    never committed. in-repo: claude-notes/ in the repo, committed.
  --decisions-file  Where the decision log goes, relative to the repo root. Default: decisions.md in the notes.
  --name            Project name for starter stacks. Defaults to the target folder name.
  --ci-review       Add .github/workflows/claude-review.yml: a Claude review when a PR is marked ready, and @claude in PR comments.
  --no-pr           Leave the files uncommitted. By default, in a clean checkout of a GitHub repo, init commits them
                    on the ai-repo-setup branch and opens a PR called "AI repo setup".
  --protect-main    Also require PRs for the default branch, admins included, and delete branches once their
                    PR is merged. This is the default for a new
                    project (without --into); an existing repo keeps its settings unless you pass this.
  --force           Overwrite files that already exist. Without it, existing files are kept and listed.

Stacks:
EOF
  list_stacks
}

list_stacks() {
  local dir s d
  for dir in "$here"/stacks/*/; do
    s=$(basename "$dir")
    d=$(sed -n 's/^DESCRIPTION="\(.*\)"$/\1/p' "$dir/stack.conf")
    printf '  %-14s %s\n' "$s" "$d"
  done
}

die() {
  echo "init: $*" >&2
  exit 1
}

[ -d "$here/core" ] && [ -d "$here/stacks" ] || die "run this from a clone of ai-repo-template."
command -v jq >/dev/null || die "jq is required (brew install jq)."

stack="" mode="" name="" into="" decisions="" notes=external force=0 ci_review=false open_pr=1 protect=0
while [ $# -gt 0 ]; do
  case "$1" in
    --stack) stack=${2:?}; shift 2 ;;
    --mode) mode=${2:?}; shift 2 ;;
    --name) name=${2:?}; shift 2 ;;
    --into) into=${2:?}; shift 2 ;;
    --notes) notes=${2:?}; shift 2 ;;
    --decisions-file) decisions=${2:?}; shift 2 ;;
    --ci-review) ci_review=true; shift ;;
    --no-pr) open_pr=0; shift ;;
    --protect-main) protect=1; shift ;;
    --force) force=1; shift ;;
    -h | --help) usage; exit 0 ;;
    *) usage >&2; die "unknown option $1" ;;
  esac
done

if [ -z "$stack" ]; then
  [ -t 0 ] || die "--stack is required when not running interactively."
  echo "Stacks:"
  list_stacks
  read -r -p "Stack: " stack
fi
[ -n "$stack" ] && [ -f "$here/stacks/$stack/stack.conf" ] || die "unknown stack '$stack'. Run ./init --help to list stacks."

if [ -z "$mode" ] && [ -t 0 ]; then
  read -r -p "Mode (solo/team) [solo]: " mode
fi
mode=${mode:-solo}
case "$mode" in solo | team) ;; *) die "mode must be solo or team." ;; esac

case "$notes" in external | in-repo) ;; *) die "--notes must be external or in-repo." ;; esac
if [ -n "$decisions" ]; then
  case "$decisions" in /* | *..* | */) die "--decisions-file must be a file path inside the repo, like DECISIONS.md." ;; esac
  printf '%s' "$decisions" | grep -Eq '^[A-Za-z0-9._/-]+$' || die "--decisions-file may only contain letters, digits, '.', '_', '-' and '/'."
fi

if [ -n "$into" ]; then
  [ -d "$into" ] || die "$into is not a directory."
  target=$(cd "$into" && pwd)
  [ "$target" != "$here" ] || die "--into points at the template itself."
  inplace=0
else
  target=$here
  inplace=1
  protect=1
fi

# Read the git state before anything is written. init commits its files and opens the setup PR only
# from a clean checkout of the repo's top level, so none of the user's own changes end up in it.
GH=${GH:-gh}
git_skip="" slug_gh="" base=""
if [ "$(git -C "$target" rev-parse --show-toplevel 2>/dev/null)" != "$(cd "$target" && pwd -P)" ]; then
  git_skip="$target is not the top of a git repo"
else
  origin_url=$(git -C "$target" config --get remote.origin.url || true)
  slug_gh=$(printf '%s\n' "$origin_url" | sed -nE 's#^(https://github\.com/|git@github\.com:|ssh://git@github\.com/)([^/]+/[^/]+)$#\2#p' | sed 's/\.git$//')
  base=$(git -C "$target" branch --show-current)
  if [ -z "$origin_url" ]; then
    git_skip="the repo has no origin remote"
  elif [ -z "$slug_gh" ]; then
    git_skip="origin is not a GitHub repo"
  elif ! command -v "$GH" >/dev/null; then
    git_skip="gh is not installed"
  elif ! git -C "$target" rev-parse -q --verify HEAD >/dev/null; then
    git_skip="the repo has no commits yet"
  elif [ -z "$base" ]; then
    git_skip="HEAD is detached"
  elif [ -n "$(git -C "$target" status --porcelain)" ]; then
    git_skip="there were uncommitted changes before init"
  elif git -C "$target" rev-parse -q --verify refs/heads/ai-repo-setup >/dev/null; then
    git_skip="the ai-repo-setup branch already exists"
  fi
fi

KIND="" DESCRIPTION=""
# shellcheck disable=SC1090
. "$here/stacks/$stack/stack.conf"

name=${name:-$(basename "$target")}
slug=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9._-]+/-/g; s/^-+//; s/-+$//')
template_commit=$(git -C "$here" rev-parse --short HEAD 2>/dev/null || echo unknown)

# The notes: the plan, the product brief and, by default, the decision log. External notes mirror
# the repo's folder name under ~/claude-notes, so every worktree of the repo shares them.
if [ "$notes" = in-repo ]; then
  notes_dir=claude-notes
  notes_abs="$target/claude-notes"
else
  repo_name=$(basename "$target" | tr -cd 'A-Za-z0-9._-')
  notes_dir="~/claude-notes/$repo_name"
  notes_abs="$HOME/claude-notes/$repo_name"
fi
decisions_in_repo=1
if [ -z "$decisions" ]; then
  decisions="$notes_dir/decisions.md"
  [ "$notes" = in-repo ] || decisions_in_repo=0
fi

# Work from a copy, because in-place mode deletes the template's own files.
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
cp -R "$here/core" "$tmp/core"
cp -R "$here/team" "$tmp/team"
cp -R "$here/stacks/$stack" "$tmp/stack"
src_core="$tmp/core"
src_stack="$tmp/stack"

# Fill in placeholders in the copy, before anything is placed, so files that were already in the
# target are never touched. __PROJECT_NAME__ is the package slug; __PROJECT_TITLE__ is the name people
# see, kept to characters that are safe in sed, HTML and JSX; __DECISIONS_FILE__ is the decision log;
# __NOTES_DIR__ is the notes folder.
title=$(printf '%s' "$name" | tr -cd 'A-Za-z0-9 ._-')
title=${title:-$slug}
while IFS= read -r f; do
  sed -i.bak "s/__PROJECT_NAME__/$slug/g; s/__PROJECT_TITLE__/$title/g; s|__DECISIONS_FILE__|$decisions|g; s|__NOTES_DIR__|$notes_dir|g" "$f" &&
    rm -f "$f.bak"
done < <(grep -rlE '__(PROJECT_NAME|PROJECT_TITLE|DECISIONS_FILE|NOTES_DIR)__' "$tmp" 2>/dev/null || true)

pending_dir="$target/.claude/ai-setup-pending"
created=()
pending=()
pending_into=()

# Puts the generated version of a file in .claude/ai-setup-pending/<name>, to be merged into <into>.
set_aside() {
  local src=$1 name=$2 into=$3
  mkdir -p "$(dirname "$pending_dir/$name")"
  cp -p "$src" "$pending_dir/$name"
  pending+=("$name")
  pending_into+=("$into")
}

# Writes src to rel in the target. A file that's already there and differs is kept, and the
# generated version is set aside for merging, unless --force.
place() {
  local src=$1 rel=$2 dest="$target/$2"
  if [ -e "$dest" ] && cmp -s "$src" "$dest"; then
    return
  fi
  if [ -e "$dest" ] && [ "$force" -eq 0 ]; then
    set_aside "$src" "$rel" "$rel"
    return
  fi
  mkdir -p "$(dirname "$dest")"
  cp -p "$src" "$dest"
  created+=("$rel")
}

copy_tree() {
  local root=$1 prefix=${2:-} f rel
  [ -d "$root" ] || return 0
  while IFS= read -r f; do
    rel=$prefix${f#"$root"/}
    place "$f" "$rel"
  done < <(find "$root" -type f ! -name .DS_Store | sort)
}

# Replaces each line that is only @@STACK_<NAME>@@ with stacks/<stack>/claude/<name>.md (or nothing),
# and __DECISIONS_FILE__ with the decision log's path.
render() {
  awk -v dir="$2" '
    /^[ \t]*@@STACK_[A-Z]+@@[ \t]*$/ {
      n = $0
      gsub(/[ \t@]/, "", n)
      sub(/^STACK_/, "", n)
      f = dir "/" tolower(n) ".md"
      while ((getline line < f) > 0) print line
      close(f)
      next
    }
    { print }
  ' "$1" | sed "s|__DECISIONS_FILE__|$decisions|g"
}

append_missing_lines() {
  local rel=$1 dest="$target/$1" src line added=0
  shift
  mkdir -p "$(dirname "$dest")"
  [ -f "$dest" ] || : >"$dest"
  for src in "$@"; do
    [ -f "$src" ] || continue
    while IFS= read -r line || [ -n "$line" ]; do
      [ -n "$line" ] || continue
      grep -qxF -- "$line" "$dest" && continue
      if [ -s "$dest" ] && [ -n "$(tail -c1 "$dest")" ]; then echo >>"$dest"; fi
      echo "$line" >>"$dest"
      added=1
    done <"$src"
  done
  [ "$added" -eq 0 ] || created+=("$rel")
}

# The first of the given paths that exists in the target, or nothing.
existing() {
  local p
  for p in "$@"; do
    if [ -e "$target/$p" ]; then
      echo "$p"
      return
    fi
  done
}

merge_json='
  def merge($a; $b):
    reduce ($b | keys_unsorted[]) as $k ($a;
      .[$k] = (
        if ($a[$k] | type) == "object" and ($b[$k] | type) == "object" then merge($a[$k]; $b[$k])
        elif ($a[$k] | type) == "array" and ($b[$k] | type) == "array" then $a[$k] + ($b[$k] - $a[$k])
        else $b[$k] end));
  reduce .[] as $x ({}; merge(.; $x))
'

render "$src_core/CLAUDE.md" "$src_stack/claude" >"$tmp/CLAUDE.md"
render "$src_core/REVIEW.md" "$src_stack/claude" >"$tmp/REVIEW.md"
: >"$tmp/gitattributes"
[ "$decisions_in_repo" = 0 ] || echo "$decisions merge=union" >"$tmp/gitattributes"

settings="$target/.claude/settings.json"
settings_inputs=("$src_core/settings.json")
[ ! -f "$src_stack/settings.json" ] || settings_inputs+=("$src_stack/settings.json")
[ ! -f "$settings" ] || settings_inputs=("$settings" "${settings_inputs[@]}")
jq -s "$merge_json" "${settings_inputs[@]}" >"$tmp/settings.json"
if [ "$notes" = external ]; then
  # Claude reads and edits the notes outside the repo without asking.
  jq --arg d "$notes_dir" '
    def add($xs): reduce $xs[] as $x (. // []; if index([$x]) then . else . + [$x] end);
    .permissions.allow |= add(["Read(\($d)/**)", "Edit(\($d)/**)", "Write(\($d)/**)"])
    | .permissions.additionalDirectories |= add([$d])
  ' "$tmp/settings.json" >"$tmp/settings.notes.json"
  mv "$tmp/settings.notes.json" "$tmp/settings.json"
fi

if [ "$inplace" -eq 1 ]; then
  for p in core stacks team tests user init install-user README.md CLAUDE.md; do
    rm -rf "${here:?}/$p"
  done
fi

copy_tree "$src_core/tree"
copy_tree "$src_stack/tree"
copy_tree "$src_stack/scripts" ".claude/scripts/"
[ "$mode" = team ] && copy_tree "$tmp/team/tree"

# A repo that already has guidance keeps it: the generated version is set aside for merging.
for doc in CLAUDE.md REVIEW.md; do
  have=$(existing ".claude/$doc" "$doc")
  if [ -n "$have" ] && cmp -s "$tmp/$doc" "$target/$have"; then
    continue # already set up by an earlier run
  elif [ -n "$have" ] && [ "$force" -eq 0 ]; then
    set_aside "$tmp/$doc" "$doc" "$have"
  else
    place "$tmp/$doc" ".claude/$doc"
  fi
done
if [ "$decisions_in_repo" = 1 ]; then
  place "$src_core/decisions.md" "$decisions"
elif [ ! -e "$notes_abs/decisions.md" ]; then
  mkdir -p "$notes_abs"
  cp -p "$src_core/decisions.md" "$notes_abs/decisions.md"
  created+=("$decisions")
fi
[ ! -f "$src_stack/README.md.tpl" ] || place "$src_stack/README.md.tpl" README.md
[ "$ci_review" = false ] || place "$src_core/ci-review/claude-review.yml" .github/workflows/claude-review.yml

mkdir -p "$target/.claude"
if [ -f "$settings" ]; then created+=(".claude/settings.json (merged)"); else created+=(".claude/settings.json"); fi
cp "$tmp/settings.json" "$settings"

append_missing_lines .claude/protected-paths "$src_core/protected-paths" "$src_stack/protected-paths"
append_missing_lines .gitignore "$src_core/gitignore" "$src_stack/gitignore"
[ ! -s "$tmp/gitattributes" ] || append_missing_lines .gitattributes "$tmp/gitattributes"
append_missing_lines .worktreeinclude "$src_core/worktreeinclude"
append_missing_lines .claude/pr-size-ignore "$src_core/pr-size-ignore" "$src_stack/pr-size-ignore"

chmod +x "$target"/.claude/scripts/* "$target"/.claude/hooks/*.sh 2>/dev/null || true

# gh opens PRs in the repo it resolves from the remotes, and with an `upstream` remote it can pick
# that one. Pin it to origin unless a default was already chosen with `gh repo set-default`.
gh_pinned=0
if [ "$inplace" -eq 0 ] && git -C "$target" remote get-url origin >/dev/null 2>&1 &&
  ! git -C "$target" config --get-regexp '^remote\..*\.gh-resolved$' >/dev/null 2>&1; then
  git -C "$target" config remote.origin.gh-resolved base
  gh_pinned=1
fi

jq -n --arg stack "$stack" --arg mode "$mode" --arg commit "$template_commit" --arg decisions "$decisions" --arg notes "$notes" --arg notes_dir "$notes_dir" --argjson ci_review "$ci_review" \
  --arg date "$(date -u +%F)" \
  '{template: "ai-repo-template", template_commit: $commit, stack: $stack, mode: $mode, notes: $notes, notes_dir: $notes_dir, decisions_file: $decisions, ci_review: $ci_review, created: $date}' \
  >"$target/.claude/ai-setup.json"

if [ "${#pending[@]}" -gt 0 ]; then
  {
    echo "# Files to merge"
    echo
    echo "\`init\` found these files already in the repo and left them unchanged. The generated version of each is in this folder. Merge it into the existing file, keeping this repo's content and adding what the setup needs. Then delete this folder."
    echo
    echo "- \`package.json\`: add the missing scripts, dependencies and devDependencies, keep this repo's name, then run \`.claude/scripts/setup\`."
    echo "- \`README.md\`: add how to run the project."
    echo
    echo "| Generated | Merge into |"
    echo "| --- | --- |"
    i=0
    while [ "$i" -lt "${#pending[@]}" ]; do
      echo "| \`.claude/ai-setup-pending/${pending[$i]}\` | \`${pending_into[$i]}\` |"
      i=$((i + 1))
    done
  } >"$pending_dir/MERGE.md"
fi

# Hand the setup over as a PR instead of leaving it uncommitted. Each step that fails leaves the
# files in place and says why, because they're already written.
pr_url="" pr_note="" protect_note=""
if [ "$open_pr" -eq 0 ]; then
  pr_note="Not committed (--no-pr)."
elif [ -n "$git_skip" ]; then
  pr_note="Not committed: $git_skip."
else
  pr_body="Adds the Claude Code setup from ai-repo-template: stack \`$stack\`, $mode mode, notes $notes ($notes_dir).

Start with \`.claude/WORKFLOW.md\`. \`.claude/ai-setup.json\` records how this was generated."
  if [ "${#pending[@]}" -gt 0 ]; then
    pr_body="$pr_body

These files already existed and were kept: ${pending_into[*]}. The generated versions are in \`.claude/ai-setup-pending/\`, which is gitignored; merge them in a follow-up commit on this branch."
  fi
  if ! { git -C "$target" switch -q -c ai-repo-setup &&
    git -C "$target" add -A &&
    git -C "$target" commit -q -m "AI repo setup"; }; then
    pr_note="Couldn't commit the files on the ai-repo-setup branch; see the git error above."
  elif ! git -C "$target" push -q -u origin ai-repo-setup; then
    pr_note="Committed on ai-repo-setup, but the push failed. Push it and open the PR yourself."
  elif ! pr_url=$("$GH" pr create -R "$slug_gh" --base "$base" --head ai-repo-setup --title "AI repo setup" --body "$pr_body"); then
    pr_url=""
    pr_note="Pushed ai-repo-setup, but gh couldn't open the PR. Open it yourself: gh pr create --head ai-repo-setup"
  fi
fi
if [ "$protect" -eq 1 ] && [ -n "$slug_gh" ] && command -v "$GH" >/dev/null; then
  default_branch=$("$GH" repo view "$slug_gh" --json defaultBranchRef -q .defaultBranchRef.name 2>/dev/null || true)
  default_branch=${default_branch:-main}
  if printf '%s' '{"required_status_checks":null,"enforce_admins":true,"required_pull_request_reviews":{"required_approving_review_count":0},"restrictions":null}' |
    "$GH" api -X PUT "repos/$slug_gh/branches/$default_branch/protection" --input - >/dev/null; then
    protect_note="Protected $default_branch on GitHub: changes land through PRs, admins included."
    # A merged PR's branch is deleted, so nothing is left behind pointing at it.
    if "$GH" api -X PATCH "repos/$slug_gh" -F delete_branch_on_merge=true >/dev/null; then
      protect_note="$protect_note Merged branches are deleted."
    fi
  else
    protect_note="Couldn't protect $default_branch: a private repo needs GitHub Pro or Team for branch protection, and you need admin rights."
  fi
elif [ "$protect" -eq 1 ]; then
  if [ -z "$slug_gh" ]; then protect_note="Didn't protect the default branch: the repo isn't on GitHub."; else protect_note="Didn't protect the default branch: gh is not installed."; fi
fi

echo
echo "Set up '$stack' ($mode) in $target"
echo "Notes (plan, product brief, decisions): $notes_dir"
echo "Written: ${#created[@]} files"
if [ "${#pending[@]}" -gt 0 ]; then
  echo
  echo "Kept ${#pending[@]} existing files unchanged: ${pending_into[*]}"
  echo "The generated versions are in .claude/ai-setup-pending/ (gitignored). Ask Claude:"
  echo "  merge the files listed in .claude/ai-setup-pending/MERGE.md"
  echo "Or rerun with --force to overwrite them."
fi
if [ "$gh_pinned" = 1 ]; then
  echo
  echo "gh now opens pull requests in origin ($(git -C "$target" remote get-url origin)), not in another remote such as upstream."
fi
if [ "$inplace" -eq 0 ] && [ "$KIND" = starter ]; then
  echo
  echo "check runs Prettier on the whole repo, including files that were here before."
  echo "Format them, or list the ones that must stay as they are in .prettierignore."
fi
echo
if [ -n "$pr_url" ]; then
  echo "Opened the setup PR: $pr_url"
  echo "You're on the ai-repo-setup branch. Push follow-up changes to it; after you merge it, switch back to $base and pull."
else
  echo "$pr_note"
fi
[ -z "$protect_note" ] || echo "$protect_note"
echo
echo "Next:"
if [ "$KIND" = starter ]; then
  echo "  .claude/scripts/setup && .claude/scripts/check"
else
  echo "  Fill in .claude/scripts/ for this repo's tools, then run .claude/scripts/check."
fi
if [ -n "$pr_url" ]; then
  echo "  Fill in the Project section of .claude/CLAUDE.md, push it to the setup PR, then merge the PR."
else
  echo "  Fill in the Project section of .claude/CLAUDE.md, then commit."
fi
echo "  Then read .claude/WORKFLOW.md for the loop, from /kickoff to the merge."
if [ "$ci_review" = true ]; then
  echo "  For the Claude review on PRs: run /install-github-app in Claude Code, and add the ANTHROPIC_API_KEY"
  echo "  or CLAUDE_CODE_OAUTH_TOKEN repository secret."
fi
if [ "$mode" = team ]; then
  echo "  Replace the teams in .github/CODEOWNERS and set up branch protection."
fi
