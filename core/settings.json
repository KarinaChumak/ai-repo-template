{
  "permissions": {
    "allow": [
      "Bash(.claude/scripts/check)",
      "Bash(.claude/scripts/quick-check)",
      "Bash(.claude/scripts/test)",
      "Bash(.claude/scripts/test *)",
      "Bash(.claude/scripts/fix *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(.claude/scripts/ticket *)"
    ],
    "ask": ["Bash(git push *)"],
    "deny": ["Bash(gh pr merge *)", "Read(./.env)", "Read(./.env.*)", "Read(./secrets/**)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ticket-context.sh" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-paths.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-check.sh" }]
      }
    ]
  }
}
